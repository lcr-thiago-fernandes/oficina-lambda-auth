# ==========================================
# Execucao LOCAL da oficina-auth-api (dotnet run em src/OficinaAuth.Api)
# Em Lambda nada disto existe: segredos vem do Secrets Manager e o banco do SSM.
# ==========================================

# Banco: aponte para o PostgreSQL do docker-compose do oficina-app (ja migrado e com o
# admin bootstrapado). Connection string completa dispensa Banco__Host/Porta/Nome/Usuario.
Banco__ConnectionString=Host=localhost;Port=5432;Database=oficina;Username=oficina;Password=oficina

# Segredos por variavel de ambiente (Segredos__Origem=Ambiente)
Segredos__Origem=Ambiente
# O MESMO valor de JWT_SECRET do .env do oficina-app, senao a API rejeita o token.
JWT_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Contador de tentativas em memoria (Tentativas__Armazenamento=Memoria)
Tentativas__Armazenamento=Memoria

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:8081
